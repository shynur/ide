[Unit]
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStartPre=/usr/bin/docker rm -f ide-for-shynur
ExecStartPre=/bin/bash -c "if ! docker images --format table | egrep '^([^[:blank:]]+/)?shynur/ide[[:blank:]]'; then docker pull docker.cnb.cool/shynur/ide; fi"
ExecStart=/bin/bash -c '/usr/bin/docker run -d -p 23389:3389 -p 26080:6080 -p 22222:22 -p 28080:80 -p 24443:443 -p 27890:7890 -p 58628:58627    --name ide-for-shynur --hostname ide-for-shynur    -v /etc/shynur-ide/:/etc/shynur-ide/:ro    -v /home/shynur/.git-credentials:/root/.git-credentials:ro    `file_to_mount=authorized_keys; file_to_mount=.ssh/$file_to_mount; [ -f /home/shynur/$file_to_mount ] && echo "-v /home/shynur/$file_to_mount:/root/$file_to_mount:ro"` `file_to_mount=id_ed25519; file_to_mount=.ssh/$file_to_mount; [ -f /home/shynur/$file_to_mount ] && echo "-v /home/shynur/$file_to_mount:/root/$file_to_mount:ro"` `file_to_mount=id_ed25519.pub; file_to_mount=.ssh/$file_to_mount; [ -f /home/shynur/$file_to_mount ] && echo "-v /home/shynur/$file_to_mount:/root/$file_to_mount:ro"`     -v /home/shynur/.bash_history:/root/.bash_history    -v /home/shynur/.cache/:/root/.cache/    -v /home/shynur/.conan2/p/:/root/.conan2/p/    -v /home/shynur/ws/:/root/ws/    docker.cnb.cool/shynur/ide launch-this-ide.bash'
ExecStartPost=/bin/bash -c "{ while ! docker ps --format '{{.Names}}' | grep -q '^ide-for-shynur$'; do sleep 1; done; echo 'shynur-ide.service: container started successfully' | tee /dev/console; } &"
ExecStartPost=/bin/bash -c "while true; do docker pull docker.cnb.cool/shynur/ide && echo 'shynur-ide.service: pull done' | tee /dev/console; docker image prune -f; sleep 6h; done &"
ExecStartPost=/bin/bash -c "while true; do wget -qO /etc/systemd/system/shynur-ide.service https://raw.githubusercontent.com/shynur/ide/trunk/shynur-ide.service && echo 'shynur-ide.service: self-update done' | tee /dev/console; sleep 3h; done &"
ExecStop=/usr/bin/docker image prune -f

[Install]
WantedBy=multi-user.target
