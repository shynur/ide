[Unit]
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStartPre=/usr/bin/docker rm -f ide-for-shynur
ExecStartPre=/bin/bash -c "if ! docker images --format table | egrep '/?shynur/ide[[:blank:]]'; then docker pull docker.cnb.cool/shynur/ide; fi"
ExecStart=/usr/bin/docker run -d -p 22222:22 --name ide-for-shynur    -v /etc/shynur-ide/:/etc/shynur-ide/:ro    -v /home/shynur/.git-credentials:/root/.git-credentials    -v /home/shynur/.ssh/:/root/.ssh/    -v /home/shynur/.bash_history:/root/.bash_history    -v /home/shynur/.cache/:/root/.cache/    -v /home/shynur/.conan2/p/:/root/.conan2/p/    -v /home/shynur/ws/:/root/ws/    docker.cnb.cool/shynur/ide /usr/sbin/sshd -D
ExecStartPost=/bin/bash -c 'echo shynur-ide.service: container started successfully >/dev/console'
ExecStop=/usr/bin/docker image prune -f

[Install]
WantedBy=multi-user.target
